#!/bin/bash
# Show the results of a run.
#
#   results              the newest run
#   results <yourname>   your newest run
#   results <run-folder> that run
set -u

R="$HOME/team14/runs"
ARG=${1:-}

if [ -z "$ARG" ]; then
  DIR=$(ls -1dt "$R"/*/ 2>/dev/null | head -1)
elif [ -d "$ARG" ]; then
  DIR="$ARG"
elif [ -d "$R/$ARG" ]; then
  DIR="$R/$ARG"
else
  DIR=$(ls -1dt "$R"/*"$ARG"*/ 2>/dev/null | head -1)
fi

if [ -z "${DIR:-}" ] || [ ! -d "$DIR" ]; then
  echo "no run found. Runs available:"
  ls -1 "$R" | grep -v '\.log$'
  exit 1
fi

DIR=${DIR%/}
echo "=== $(basename "$DIR") ==="

if grep -q '^EXIT=0' "$DIR/run.log" 2>/dev/null; then
  echo "status: finished"
elif grep -q '^EXIT=' "$DIR/run.log" 2>/dev/null; then
  echo "status: FAILED, last lines of the log:"
  tail -15 "$DIR/run.log"
  exit 1
else
  echo "status: still running"
  echo
  tail -3 "$DIR/run.log" 2>/dev/null
  echo
  echo "watch it with: tail -f $DIR/run.log"
  exit 0
fi

echo
TABLE=$(sed -n '/refolded design(s) from/,$p' "$DIR/run.log" 2>/dev/null)
if [ -n "$TABLE" ]; then
  echo "$TABLE"
else
  # Older runs did not append the table, so work it out now.
  #
  # ONLY look inside this run's own directory (and whatever its out/ symlink
  # points at). An earlier version also searched the shared runs tree and took
  # the first match, which silently reported a DIFFERENT run's numbers. That is
  # the kind of bug that puts the wrong figures on a slide.
  CSV=$(find -L "$DIR" -name refold_metrics.csv 2>/dev/null | head -1)
  if [ -n "$CSV" ]; then
    echo "(from $CSV)"
    "$HOME/team14/.venv/bin/python" "$HOME/team14/scripts/report.py" "$CSV"
  else
    echo "No refold_metrics.csv inside $DIR."
    echo "This run has no scored output of its own yet, or it wrote it"
    echo "somewhere else. Do NOT quote another run's numbers for it."
  fi
fi

echo
echo "note: $DIR/NOTE.md"
