   "kind": "request-template",
   "description": "Supply a complete structure with the chain IDs in these parameters; replace them with your actual heavy/light or general-chain labels. Upload/finalize the required payloads and canonical manifest, then fill required_owner_fields with your own pointers. This is not an exact-release or scientific qualification claim.",
   "input_preparation": {
    "bundle": {
     "format": "tar",
     "compression": "none",
     "path_base": "Archive root; use relative POSIX paths without links, duplicates or traversal. No enclosing-directory stripping.",
     "files": {
      "parameters.pdb_file": "One structure, or select parameters.pdb_dir instead.",
      "parameters.pdb_dir": "Directory of PDB structures; mutually exclusive with pdb_file.",
      "parameters.pdbs_csv": "Optional native batch CSV, only with pdb_dir; requires a pdb column and uses native chain columns. Entries identify structures under pdb_dir.",
      "parameters.model_file": "Optional AntiFold checkpoint in the same archive. ESM-IF1 uses its named checkpoint and does not accept this field."
     },
     "chains": "Set the typed heavy_chain/light_chain/nanobody_chain/antigen_chain fields to actual structure chain IDs. ESM-IF1 always uses custom_chain_mode; sampling_temp is a space-separated string of positive temperatures, not a JSON number."
    }
   },
   "request": {
    "schema": "fs2-serve.nebius.ai/scientific-run-request/v1",
    "operation": "inverse-fold",
    "service_class": "customer-batch",
    "parameters": {
     "pdb_file": "structure.pdb",
     "heavy_chain": "H",
     "num_seq_per_target": 4,
     "light_chain": "L"
    }
   },
   "required_owner_fields": [
    "input_manifest"
   ]
  }
